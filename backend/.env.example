# App
NODE_ENV="development"
PORT="3000"
FRONTEND_URL="http://localhost:5173"
LOG_LEVEL="info"

# Database
DATABASE_URL="file:./dev.db"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_URL="http://localhost:7700"
MEILISEARCH_KEY="marketplace_search_key"

# JWT
JWT_SECRET="replace-with-a-long-random-access-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# OTP / notifications
OTP_PROVIDER="mock"
SMTP_HOST=""
SMTP_FROM="no-reply@marketplace.local"
SMS_PROVIDER_URL=""
SMS_PROVIDER_KEY=""

# Payments
PAYMENT_WEBHOOK_SECRET="replace-with-provider-webhook-secret"

# Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# Default admin seed
ADMIN_EMAIL="admin@marketplace.com"
ADMIN_PASSWORD="replace-before-production"
